{
  "name": "tagwise",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "biome check",
    "check:fix": "biome check --fix",
    "dev": "bun run --watch src/main.ts",
    "test": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:unit": "bun test tests/config.test.ts tests/path.test.ts tests/logger.test.ts tests/operation-state.test.ts tests/operation-apply.test.ts tests/producer-scaffold.test.ts tests/tui-shortcuts.test.ts",
    "test:integration": "bun test tests/filesystem-service.test.ts tests/library-repository.test.ts tests/producer-loader.test.ts tests/producer-pipeline.test.ts",
    "test:e2e": "bun test tests/cli.integration.test.ts",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "start": "bun run src/main.ts",
    "format": "biome format --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "husky": "9.1.7"
  },
  "peerDependencies": {
    "typescript": "6.0.3"
  },
  "overrides": {
    "shell-quote": "1.12.0"
  },
  "dependencies": {
    "@opentui-ui/toast": "0.0.5",
    "@opentui/core": "0.4.2",
    "@opentui/react": "0.4.2",
    "cli-spinners": "3.4.0",
    "cn": "0.5.1",
    "commander": "15.0.0",
    "opentui-spinner": "0.0.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sanitize-filename": "1.6.4",
    "shadcn": "4.23.0",
    "taglib-wasm": "1.4.0"
  }
}
